[Unit]
Description=Silex registry v2 loopback HTTPS staging gateway
Wants=silex-registry-stage.service
After=silex-registry-stage.service
StartLimitIntervalSec=60
StartLimitBurst=3
[Service]
Type=simple
User=silex-registry-stage-web
Group=silex-registry-stage-web
SupplementaryGroups=silex-registry-stage
RootDirectory=/var/lib/silex-registry-stage/root
MountAPIVFS=yes
ExecStart=/usr/sbin/apache2 -f /etc/stage/httpd.conf -DFOREGROUND
Environment=PHP_INI_SCAN_DIR=
ExecStartPre=/usr/bin/php8.2 -c /etc/stage/php.ini /etc/stage/isolation.php gateway
ExecStartPre=/usr/sbin/apache2 -f /etc/stage/httpd.conf -t
RuntimeDirectory=silex-registry-stage-web
RuntimeDirectoryMode=0700
BindPaths=/run/silex-registry-stage-web:/run/web
BindReadOnlyPaths=/run/silex-registry-stage:/run/stage /var/lib/silex-registry-stage/gateway:/gateway
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/web
TemporaryFileSystem=/tmp:rw,nosuid,nodev,noexec,size=8M
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=~@mount @reboot @swap @raw-io @privileged
UMask=0077
MemoryMax=128M
TasksMax=32
CPUQuota=50%
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
